# NVIDIA Build hosted API (OpenAI-compatible API)
NVIDIA_API_KEY=replace-me
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Use a dedicated MySQL account with SELECT permissions only.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=querypilot_demo
MYSQL_USER=querypilot_readonly
MYSQL_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-this-local-only

# Optional comma-separated allowlist of tables, e.g. customers,orders
MYSQL_ALLOWED_TABLES=
MAX_ROWS=100
QUERY_TIMEOUT_SECONDS=8
MAX_CONVERSATION_TURNS=6
